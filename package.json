{
  "name": "swiftfix",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "build": "npx prisma generate && next build --webpack",
    "build:vercel": "npx prisma db push && npx prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "generate-favicons": "node scripts/generate-favicons.mjs",
    "predeploy": "pnpm run lint && pnpm run build",
    "safe-push": "pnpm run predeploy && git push",
    "clean-install": "node -e \"const {rmSync}=require('fs'); rmSync('node_modules',{recursive:true,force:true});\" && pnpm install",
    "prepare": "husky"
  },
  "dependencies": {
    "@prisma/client": "6.5.0",
    "@privy-io/react-auth": "^3.18.0",
    "@privy-io/server-auth": "^1.32.5",
    "@solana-program/memo": "^0.8.0",
    "@solana-program/system": "^0.8.1",
    "@solana/kit": "^3.0.3",
    "@supabase/supabase-js": "^2.57.2",
    "fast-check": "^4.6.0",
    "framer-motion": "^12.38.0",
    "groq-sdk": "^1.1.2",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-paystack": "^6.0.0",
    "viem": "^2.37.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "husky": "^9.1.7",
    "prisma": "6.5.0",
    "sharp": "^0.35.1",
    "tailwindcss": "^4",
    "to-ico": "^1.1.5",
    "typescript": "^5"
  },
  "overrides": {
    "plain-crypto-js": "0.0.1-security.0"
  },
  "prisma": {
    "seed": "node prisma/seed.cjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "esbuild",
      "bufferutil",
      "keccak",
      "utf-8-validate",
      "unrs-resolver",
      "@reown/appkit"
    ]
  }
}
